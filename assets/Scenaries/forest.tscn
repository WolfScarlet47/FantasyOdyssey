[sub_resource type="Shader" id="Shader_forest_ground"]
code = "shader_type canvas_item;\n\nfloat hash21(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nfloat noise2(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = hash21(i);\n    float b = hash21(i + vec2(1.0, 0.0));\n    float c = hash21(i + vec2(0.0, 1.0));\n    float d = hash21(i + vec2(1.0, 1.0));\n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\nvoid fragment() {\n    vec2 p = UV * vec2(180.0, 120.0);\n    float broad = noise2(p * 0.10);\n    float detail = noise2(p * 0.85);\n    float fine = noise2(p * 3.5);\n    float variation = broad * 0.48 + detail * 0.37 + fine * 0.15;\n    vec3 soil = vec3(0.105, 0.145, 0.095);\n    vec3 moss = vec3(0.235, 0.285, 0.145);\n    vec3 ground = mix(soil, moss, smoothstep(0.28, 0.78, variation));\n    float fleck = step(0.965, hash21(floor(p * 1.8)));\n    ground = mix(ground, vec3(0.34, 0.32, 0.19), fleck * 0.28);\n    COLOR = vec4(ground, 1.0);\n}"

