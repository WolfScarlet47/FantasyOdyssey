[sub_resource type="Shader" id="Shader_forest_ground"]
code = "shader_type canvas_item;

float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise2(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

void fragment() {
    vec2 p = UV * vec2(180.0, 120.0);
    float broad = noise2(p * 0.10);
    float detail = noise2(p * 0.85);
    float fine = noise2(p * 3.5);
    float variation = broad * 0.48 + detail * 0.37 + fine * 0.15;
    vec3 soil = vec3(0.105, 0.145, 0.095);
    vec3 moss = vec3(0.235, 0.285, 0.145);
    vec3 ground = mix(soil, moss, smoothstep(0.28, 0.78, variation));
    float fleck = step(0.965, hash21(floor(p * 1.8)));
    ground = mix(ground, vec3(0.34, 0.32, 0.19), fleck * 0.28);
    COLOR = vec4(ground, 1.0);
}"

